# Python virtual environments
venv/
.venv/

# Python bytecode and caches
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# ML model weights (downloaded at runtime)
/models/

# SVN version control metadata
.svn/

# SVN branch copies
branches/

# Node.js dependencies
web/node_modules/

# Frontend build artifacts
web/dist/

# Runtime data: user-uploaded documents, videos, images
watch_directory/

# Vector database
chroma_db/
chroma_db_backup_*/

# Application logs
logs/

# Repair/diagnostic backups
backups/

# Scraped blog images and articles
scrapingImages/
scrape_article/

# Runtime data directory (anchored to root; preserves rag_knowledge/data/)
/data/*
!/data/retrieval_intent_policies.json
!/data/migrations/
!/data/migrations/retrieval_intent_profiles_v1.json
!/data/structured_retrieval_regression.json
!/data/domain_catalog.json
!/data/product_relation_backbone.json
!/data/product_relation_backbone_preview.json

# Generated / historical artifacts (also covered by /data/*; kept explicit)
/data/archive/
# Offline lineage / parse audit spikes (may contain source text)
/data/chunk_audit/


# IDE settings
.idea/

# Claude Code local settings
.claude/settings.local.json

# Config files with internal IPs (use .example versions instead)
config.ini
config-prod.ini

# Zero-byte junk files
=1.2.0
_debug_out.txt

# OS-generated files
.DS_Store
Thumbs.db

# Office temporary lock files
~$*

# Compressed archives
*.tar.gz

# Local secrets (API keys); never commit
.env
.env.local
.env.*.local


